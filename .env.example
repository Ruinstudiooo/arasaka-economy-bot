# copy to .env and fill in
DISCORD_TOKEN=
CLIENT_ID=

# prefix commands, any of these start a command
PREFIX=! a!

# deploy slash commands to one guild instantly instead of waiting an hour
GUILD_ID=

# comma separated ids that can use owner only commands later
OWNER_IDS=

# where the bot keeps its own copy of the ledger
LEDGER_FILE=data/ledger.json

# aradata repo the bot reads from, owner/name
ARADATA_REPO=Ruinstudiooo/aradata
ARADATA_BRANCH=main
ARADATA_PATH=data/economy.json
# required, aradata is private. read only token is enough
GITHUB_TOKEN=
